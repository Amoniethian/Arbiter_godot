{
  "lucifer_dialogues": {
    "LCF-INTRO": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-INTRO-D01", "speaker": "Lucifer", "text": "Ah... another soul seeks my domain."},
        {"id": "LCF-INTRO-D02", "speaker": "Lucifer", "text": "I know why you've come."},
        {"id": "LCF-INTRO-D03", "speaker": "Lucifer", "text": "Your daughter... taken by one of my demons."},
        {"id": "LCF-INTRO-D04", "speaker": "Lucifer", "text": "Find the guilty one, and perhaps... I'll return her."},
        {"id": "LCF-INTRO-D05", "speaker": "Lucifer", "text": "But be warned - demons are masters of deception."},
        {"id": "LCF-INTRO-D06", "speaker": "Lucifer", "text": "Some speak only truth. Others, only lies."},
        {"id": "LCF-INTRO-D07", "speaker": "Lucifer", "text": "Place the culprit in the center of my circle."},
        {"id": "LCF-INTRO-D08", "speaker": "Lucifer", "text": "Then... we shall weigh their soul."}
      ]
    },
    "LCF-S1-INTRO": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S1-INTRO-D01", "speaker": "Lucifer", "text": "The First Circle."},
        {"id": "LCF-S1-INTRO-D02", "speaker": "Lucifer", "text": "Nine demons stand before you."},
        {"id": "LCF-S1-INTRO-D03", "speaker": "Lucifer", "text": "One took your daughter. Find them."},
        {"id": "LCF-S1-INTRO-D04", "speaker": "Lucifer", "text": "Ask your questions. Examine their belongings."},
        {"id": "LCF-S1-INTRO-D05", "speaker": "Lucifer", "text": "Truth-tellers cannot lie. Liars cannot tell truth."},
        {"id": "LCF-S1-INTRO-D06", "speaker": "Lucifer", "text": "Drag the guilty one to the center."}
      ]
    },
    "LCF-S1-SUCCESS": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S1-SUCCESS-D01", "speaker": "Lucifer", "text": "Impressive."},
        {"id": "LCF-S1-SUCCESS-D02", "speaker": "Lucifer", "text": "You've found the first culprit."},
        {"id": "LCF-S1-SUCCESS-D03", "speaker": "Lucifer", "text": "But this was merely the beginning."},
        {"id": "LCF-S1-SUCCESS-D04", "speaker": "Lucifer", "text": "Deeper circles await..."}
      ]
    },
    "LCF-S1-FAIL": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S1-FAIL-D01", "speaker": "Lucifer", "text": "Wrong."},
        {"id": "LCF-S1-FAIL-D02", "speaker": "Lucifer", "text": "That demon is innocent."},
        {"id": "LCF-S1-FAIL-D03", "speaker": "Lucifer", "text": "Your daughter remains in darkness."},
        {"id": "LCF-S1-FAIL-D04", "speaker": "Lucifer", "text": "Try again."}
      ]
    },
    "LCF-S2-INTRO": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S2-INTRO-D01", "speaker": "Lucifer", "text": "The Second Circle."},
        {"id": "LCF-S2-INTRO-D02", "speaker": "Lucifer", "text": "These demons are more cunning."},
        {"id": "LCF-S2-INTRO-D03", "speaker": "Lucifer", "text": "Think carefully before you judge."}
      ]
    },
    "LCF-S2-SUCCESS": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S2-SUCCESS-D01", "speaker": "Lucifer", "text": "Your mind is sharper than I expected."},
        {"id": "LCF-S2-SUCCESS-D02", "speaker": "Lucifer", "text": "Continue..."}
      ]
    },
    "LCF-S2-FAIL": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S2-FAIL-D01", "speaker": "Lucifer", "text": "Failure."},
        {"id": "LCF-S2-FAIL-D02", "speaker": "Lucifer", "text": "The guilty one laughs at your mistake."}
      ]
    },
    "LCF-S3-INTRO": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S3-INTRO-D01", "speaker": "Lucifer", "text": "The Third Circle."},
        {"id": "LCF-S3-INTRO-D02", "speaker": "Lucifer", "text": "You're getting closer to your daughter."},
        {"id": "LCF-S3-INTRO-D03", "speaker": "Lucifer", "text": "But the demons here are craftier still."}
      ]
    },
    "LCF-S3-SUCCESS": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S3-SUCCESS-D01", "speaker": "Lucifer", "text": "Well done."},
        {"id": "LCF-S3-SUCCESS-D02", "speaker": "Lucifer", "text": "One more circle of demons remains."}
      ]
    },
    "LCF-S3-FAIL": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S3-FAIL-D01", "speaker": "Lucifer", "text": "So close, yet so wrong."},
        {"id": "LCF-S3-FAIL-D02", "speaker": "Lucifer", "text": "Think again."}
      ]
    },
    "LCF-S4-INTRO": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S4-INTRO-D01", "speaker": "Lucifer", "text": "The Fourth Circle."},
        {"id": "LCF-S4-INTRO-D02", "speaker": "Lucifer", "text": "The final demon trial."},
        {"id": "LCF-S4-INTRO-D03", "speaker": "Lucifer", "text": "Succeed here, and you'll face the ultimate test."}
      ]
    },
    "LCF-S4-SUCCESS": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S4-SUCCESS-D01", "speaker": "Lucifer", "text": "You've proven yourself against my demons."},
        {"id": "LCF-S4-SUCCESS-D02", "speaker": "Lucifer", "text": "But now... a different challenge awaits."},
        {"id": "LCF-S4-SUCCESS-D03", "speaker": "Lucifer", "text": "Human souls. Mortals who lived, loved, and sinned."},
        {"id": "LCF-S4-SUCCESS-D04", "speaker": "Lucifer", "text": "Can you judge them fairly?"}
      ]
    },
    "LCF-S4-FAIL": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-S4-FAIL-D01", "speaker": "Lucifer", "text": "So close to the end, and yet you stumble."},
        {"id": "LCF-S4-FAIL-D02", "speaker": "Lucifer", "text": "Try again."}
      ]
    },
    "LCF-FINAL-INTRO": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-FINAL-INTRO-D01", "speaker": "Lucifer", "text": "The Final Judgment."},
        {"id": "LCF-FINAL-INTRO-D02", "speaker": "Lucifer", "text": "Nine souls stand before you."},
        {"id": "LCF-FINAL-INTRO-D03", "speaker": "Lucifer", "text": "Some are good. Some are evil."},
        {"id": "LCF-FINAL-INTRO-D04", "speaker": "Lucifer", "text": "The weak and strong of each."},
        {"id": "LCF-FINAL-INTRO-D05", "speaker": "Lucifer", "text": "Adjacent souls influence each other."},
        {"id": "LCF-FINAL-INTRO-D06", "speaker": "Lucifer", "text": "The weak evil will destroy the weak good."},
        {"id": "LCF-FINAL-INTRO-D07", "speaker": "Lucifer", "text": "The strong evil will destroy both."},
        {"id": "LCF-FINAL-INTRO-D08", "speaker": "Lucifer", "text": "But the strong good... resists the weak evil."},
        {"id": "LCF-FINAL-INTRO-D09", "speaker": "Lucifer", "text": "Arrange them so that ALL good souls survive."},
        {"id": "LCF-FINAL-INTRO-D10", "speaker": "Lucifer", "text": "Only then will I release your daughter."}
      ]
    },
    "LCF-FINAL-SUCCESS": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-FINAL-SUCCESS-D01", "speaker": "Lucifer", "text": "..."},
        {"id": "LCF-FINAL-SUCCESS-D02", "speaker": "Lucifer", "text": "You've done it."},
        {"id": "LCF-FINAL-SUCCESS-D03", "speaker": "Lucifer", "text": "Every good soul survives."},
        {"id": "LCF-FINAL-SUCCESS-D04", "speaker": "Lucifer", "text": "A deal is a deal."},
        {"id": "LCF-FINAL-SUCCESS-D05", "speaker": "Lucifer", "text": "Your daughter is free."},
        {"id": "LCF-FINAL-SUCCESS-D06", "speaker": "Lucifer", "text": "But remember this moment."},
        {"id": "LCF-FINAL-SUCCESS-D07", "speaker": "Lucifer", "text": "You've proven that even in Hell..."},
        {"id": "LCF-FINAL-SUCCESS-D08", "speaker": "Lucifer", "text": "Justice can prevail."},
        {"id": "LCF-FINAL-SUCCESS-D09", "speaker": "Lucifer", "text": "Until we meet again, Arbiter."}
      ]
    },
    "LCF-FINAL-FAIL": {
      "portrait": "res://assets/images/characters/LCF_portrait.png",
      "lines": [
        {"id": "LCF-FINAL-FAIL-D01", "speaker": "Lucifer", "text": "The flames have claimed another good soul."},
        {"id": "LCF-FINAL-FAIL-D02", "speaker": "Lucifer", "text": "Your daughter weeps in the darkness."},
        {"id": "LCF-FINAL-FAIL-D03", "speaker": "Lucifer", "text": "Try again, mortal."}
      ]
    }
  },
  "eye_tracker_intro": {
    "portrait": "res://assets/images/characters/LCF_portrait.png",
    "show_eyes_after": true,
    "lines": [
      {"id": "LCF-EYE-D01", "speaker": "Lucifer", "text": "Before we begin..."},
      {"id": "LCF-EYE-D02", "speaker": "Lucifer", "text": "I must see your soul."},
      {"id": "LCF-EYE-D03", "speaker": "Lucifer", "text": "Look into my eyes..."}
    ]
  }
}
