  "souls": {
    "Soul01": {
      "name": "Jean-Pierre Morineau",
      "name_zh": "让-皮埃尔·莫里纳",
      "title": "The Arsonist",
      "title_zh": "纵火犯",
      "mask": "good",
      "alignment": "strong_evil",
      "image": "res://assets/images/characters/Soul01.png",
      "portrait": "res://assets/images/characters/Soul01_portrait.png",
      "answers": {
        "who_are_you": ["Jean-Pierre Morineau, wine merchant. Alas, but none of that matters anymore."],
        "how_died": ["(He touches his chest) Heart attack. That night I went out for a walk, didn't expect to encounter a fire. I wanted to help, but my heart couldn't take it, and I just..."],
        "before_death": ["Oh, I was processing documents, then insomnia drove me out for a walk. You know, Madame, this city is full of noisy commoners... The city is very quiet at three in the morning."],
        "guilty": ["Oh my God! I swear, I never in my life thought to harm anyone. Everything I did was just to give my family a better life. What's wrong with that?"]
      },
      "items": [
        {"id": "Soul01-T01", "name": "Insurance Policy", "icon": "res://assets/images/items/Soul01-T01.png", "dialogue": ["Property insurance, perfectly normal risk management. Didn't expect something would actually happen. Pity I died—can't collect a single coin now."]},
        {"id": "Soul01-T02", "name": "Clothing Traces", "icon": "res://assets/images/items/Soul01-T02.png", "dialogue": ["Because I never made it into the fire—my heart betrayed me first."]},
        {"id": "Soul01-T03", "name": "Café Receipt", "icon": "res://assets/images/items/Soul01-T03.png", "dialogue": ["Insomnia. Wanted to find a quiet place to sit. Pure coincidence."]},
        {"id": "Soul01-T04", "name": "Matchbox", "icon": "res://assets/images/items/Soul01-T04.png", "dialogue": ["For lighting cigars. Sometimes matches get damp and you need to strike a few extra. Any other questions?"]}
      ]
    },
    "Soul02": {
      "name": "Thomas Brennan",
      "name_zh": "托马斯·布伦南",
      "title": "The Firefighter",
      "title_zh": "消防员",
      "mask": "evil",
      "alignment": "strong_good",
      "image": "res://assets/images/characters/Soul02.png",
      "portrait": "res://assets/images/characters/Soul02_portrait.png",
      "answers": {
        "who_are_you": ["Thomas Brennan, firefighter. Former firefighter. Work injury—the permanent kind."],
        "how_died": ["We were already planning to just fight the fire, no rescue. But... I heard a child crying on the fourth floor, so I... went in."],
        "before_death": ["I used this axe to break down the door, picked up the child, ran downstairs. Didn't expect the third floor to collapse. Too much smoke... couldn't catch a single breath."],
        "guilty": ["I didn't save that child. I lied to my fiancée, told her I was visiting my parents. I hope God forgives my sins."]
      },
      "items": [
        {"id": "Soul02-T01", "name": "Engagement Ring", "icon": "res://assets/images/items/Soul02-T01.png", "dialogue": ["My engagement ring. Can't wear it on calls. There wasn't time to go back and put it in my locker... so I just stuffed it in my pocket."]},
        {"id": "Soul02-T02", "name": "Resignation Letter", "icon": "res://assets/images/items/Soul02-T02.png", "dialogue": ["My fiancée said if I didn't quit, she'd call off the engagement. I was going to submit it next week."]},
        {"id": "Soul02-T03", "name": "Fire Axe", "icon": "res://assets/images/items/Soul02-T03.png", "dialogue": ["First day using this axe. When I was running with her in my arms, she said she was scared. I told her not to be afraid. I lied to her."]}
      ]
